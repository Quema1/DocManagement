{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Messaging": {
    "Provider": "Channel"
  },
  "Preview": {
    "BaseUrl": "https://previews.docmanagement.local",
    "SimulatedDelay": "00:00:02"
  },
  "Jwt": {
    "Issuer": "DocManagement",
    "Audience": "DocManagement.Api",
    "Lifetime": "01:00:00"
  },
  "RateLimiting": {
    "Global": {
      "TokenLimit": 100,
      "TokensPerPeriod": 20,
      "ReplenishmentPeriod": "00:00:10"
    },
    "Previews": {
      "PermitLimit": 5,
      "Window": "00:01:00"
    }
  }
}
